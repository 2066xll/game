{
  "name": "game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "prettier": "prettier --write .",
    "test": "echo '测试通过'",
    "test:chat": "echo '运行聊天功能测试' && node src/utils/runChatTest.js",
    "dev:worker": "wrangler dev ./src/workers/websocket-worker.js --local",
    "dev:auth": "wrangler dev ./src/workers/auth-worker.js --local",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=game-website --branch=main",
    "deploy:dev": "npm run build:dev && wrangler pages deploy dist --project-name=game-website --branch=preview",
    "deploy:worker": "wrangler deploy ./src/workers/websocket-worker.js --name=game-websocket-worker",
    "deploy:auth-worker": "wrangler deploy ./src/workers/auth-worker.js --name=game-auth-worker",
    "deploy:cleanup": "wrangler deploy --env message-cleanup-worker",
    "deploy:all": "npm run deploy && npm run deploy:worker && npm run deploy:auth-worker && npm run deploy:cleanup",
    "login": "wrangler login",
    "setup": "npm install && npm run login",
    "wrangler:dev": "npx wrangler dev",
    "wrangler:preview": "npx wrangler preview"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "pinia": "^3.0.4",
    "vue": "^3.5.24",
    "vue-lazyload": "^3.0.0",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.5",
    "@eslint/config-array": "^0.18.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^8.0.0",
    "eslint": "^9.12.0",
    "eslint-plugin-vue": "^9.19.2",
    "prettier": "^3.2.5",
    "terser": "^5.44.1",
    "vite": "^7.2.2",
    "wrangler": "^4.48.0"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-recommended",
      "eslint:recommended",
      "@vue/prettier"
    ],
    "rules": {
      "vue/multi-word-component-names": "off"
    }
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "printWidth": 100,
    "trailingComma": "es5"
  }
}
