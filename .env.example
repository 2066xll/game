# Cloudflare配置环境变量
# 请复制此文件为.env并填写实际值

# Cloudflare账户信息
CLOUDFLARE_ACCOUNT_ID="你的Cloudflare账户ID"
CLOUDFLARE_API_TOKEN="你的Cloudflare API令牌"

# 项目配置
PROJECT_NAME="game-website"

# 数据库配置
DATABASE_ID="你的D1数据库ID"

# KV命名空间
KV_NAMESPACE_ID="你的KV命名空间ID"

# 环境配置
NODE_ENV="production"

# API端点配置
API_ENDPOINT="https://你的域名.workers.dev"
WEBSOCKET_ENDPOINT="wss://你的域名.workers.dev"